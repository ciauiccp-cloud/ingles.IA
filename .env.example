# Copie para .env e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). A chave "anon/publishable" é pública por design;
# a segurança vem das regras RLS. NUNCA coloque a service_role key ou a chave da IA aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
